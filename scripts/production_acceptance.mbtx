import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/process",
  "moonbitlang/async/shell",
  "moonbitlang/async/socket",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

// Frozen acceptance parameters. Change these only with a reviewed capacity
// decision; measured values must not be used to loosen the gate.
let latency_iterations = 64
let steady_duration_ms = 10000
let steady_batch_size = 1
let steady_paced_ms = 50
let minimum_steady_events = 50L
let minimum_throughput_x1000 = 10000L
let maximum_input_p99_ms = 1000L
let storage_budget_bytes = 268435456L
let driver_event_limit = 200000

///|
async fn wait_for_tcp(endpoint : String) -> Unit {
  @async.with_timeout(30000, () => {
    for ;; {
      try @socket.Tcp::connect(@socket.Addr::parse(endpoint)) catch {
        _ => @async.sleep(50)
      } noraise {
        connection => {
          connection.close()
          break
        }
      }
    }
  })
}

///|
async fn stop_pid(pid : Int, signal : String) -> Int {
  ignore(@process.run("/bin/kill", [signal, pid.to_string()]))
  @async.with_timeout(15000, () => @process.wait_pid(pid)) catch {
    _ => {
      ignore(@process.run("/bin/kill", ["-KILL", pid.to_string()]))
      @process.wait_pid(pid)
    }
  }
}

///|
fn require_output(output : @shell.Output, label : String) -> String raise {
  if output.exit_code() != 0 {
    fail(label + " exited " + output.exit_code().to_string() + ": " + output.stdout())
  }
  output.stdout()
}

///|
fn metric(text : String, name : String) -> Int64 raise {
  for line in text.split("\n") {
    if line.has_prefix(name + "=") {
      let fields = line.to_owned().split("=").to_array()
      return @string.parse_int64(fields[1]) catch {
        _ => fail("invalid metric " + line.to_owned())
      }
    }
  }
  fail("missing metric " + name)
}

///|
async fn write_evidence(root : String, text : String) -> Unit {
  @fs.write_file(root + "/production-evidence.txt", text)
}

///|
async fn wait_for_text(path : String, needle : String) -> Unit {
  @async.with_timeout(30000, () => {
    for ;; {
      if @fs.exists(path) && @fs.read_file(path).text().contains(needle) {
        break
      }
      @async.sleep(50)
    }
  })
}

///|
async fn main {
  let args = @env.args()
  let kafka = if args.length() > 1 {
    @fs.realpath(args[1])
  } else if @fs.exists("/tmp/kafka_2.13-4.0.0") {
    @fs.realpath("/tmp/kafka_2.13-4.0.0")
  } else {
    fail("Kafka distribution not found; pass its extracted path as the only argument")
  }
  let root = @fs.tmpdir(prefix="moonweave-production-acceptance-")
  let hardware = @shell.Cmd("uname", ["-a"]).output()
  let cpu = @shell.Cmd("nproc", []).output()
  let memory = @shell.Cmd("free", ["-b"]).output()
  let evidence_header =
    "MoonWeave production acceptance\n" +
    "hardware=" + hardware.stdout() +
    "cpu_count=" + cpu.stdout() +
    "memory=" + memory.stdout() +
    "topology=1 Coordinator, 1 Worker, 1 Kafka broker; HA separately uses 3 Coordinator processes\n" +
    "operator=reachability builtin:v1; key distribution=single account key; event payload=source/target JSON; input batch=1 for latency, " + steady_batch_size.to_string() + " for steady state\n" +
    "latency_iterations=" + latency_iterations.to_string() +
    " steady_duration_ms=" + steady_duration_ms.to_string() +
    " steady_batch_size=" + steady_batch_size.to_string() +
    " steady_paced_ms=" + steady_paced_ms.to_string() +
    " minimum_steady_events=" + minimum_steady_events.to_string() +
    " minimum_throughput_events_per_sec=" + (minimum_throughput_x1000 / 1000).to_string() +
    " maximum_input_p99_ms=" + maximum_input_p99_ms.to_string() +
    " storage_budget_bytes=" + storage_budget_bytes.to_string() +
    " driver_event_limit=" + driver_event_limit.to_string() + "\n"
  println("Production acceptance state: " + root)
  @shell.Cmd(
    "moon",
    [
      "build", "--target", "native", "cmd/coordinator", "cmd/worker", "cmd/driver",
      "cmd/performance_fixture",
    ],
  ).run(timeout_ms=180000)

  println("[1/6] coordinator process crash and HA recovery")
  @shell.Cmd("moon", ["run", "scripts/coordinator_ha_acceptance.mbtx"]).run(timeout_ms=180000)

  let coordinator = @fs.realpath(
    "_build/native/debug/build/moonweave/moonweave/cmd/coordinator/coordinator.exe",
  )
  let worker = @fs.realpath(
    "_build/native/debug/build/moonweave/moonweave/cmd/worker/worker.exe",
  )
  let driver = @fs.realpath(
    "_build/native/debug/build/moonweave/moonweave/cmd/driver/driver.exe",
  )
  let performance = @fs.realpath(
    "_build/native/debug/build/moonweave/moonweave/cmd/performance_fixture/performance_fixture.exe",
  )
  let submission = @fs.realpath("cmd/driver_fixture/process-submission.json")
  let coordinator_listener = @socket.TcpServer(@socket.Addr::parse("127.0.0.1:0"))
  let coordinator_port = coordinator_listener.addr.port()
  let driver_listener = @socket.TcpServer(@socket.Addr::parse("127.0.0.1:0"))
  let driver_port = driver_listener.addr.port()
  coordinator_listener.close()
  driver_listener.close()
  let coordinator_endpoint = "127.0.0.1:" + coordinator_port.to_string()
  let driver_endpoint = "127.0.0.1:" + driver_port.to_string()
  let cluster = "production-acceptance-cluster"
  let coordinator_storage = root + "/coordinator"
  let worker_storage = root + "/worker"
  let coordinator_log = @process.redirect_to_file(root + "/coordinator.log")
  let worker_log = @process.redirect_to_file(root + "/worker.log")
  let coordinator_pid = @process.spawn_orphan(
    coordinator,
    [
      "--cluster", cluster,
      "--coordinator", "coordinator-0",
      "--bind", coordinator_endpoint,
      "--advertise", coordinator_endpoint,
      "--driver-bind", driver_endpoint,
      "--driver-advertise", driver_endpoint,
      "--storage", coordinator_storage,
      "--storage-budget-bytes", storage_budget_bytes.to_string(),
      "--driver-event-limit", driver_event_limit.to_string(),
      "--workers", "worker-0@boot-0",
    ],
    stdout=coordinator_log,
    stderr=coordinator_log,
  )
  let worker_pid = @process.spawn_orphan(
    worker,
    [
      "--cluster", cluster,
      "--coordinator", "coordinator-0",
      "--coordinator-endpoint", coordinator_endpoint,
      "--worker", "worker-0",
      "--incarnation", "boot-0",
      "--storage", worker_storage,
      "--job-config", submission,
      "--storage-budget-bytes", storage_budget_bytes.to_string(),
    ],
    stdout=worker_log,
    stderr=worker_log,
  )
  let mut cluster_stopped = false
  defer {
    @async.protect_from_cancel(() => {
      if !cluster_stopped {
        ignore(stop_pid(coordinator_pid, "-KILL"))
        ignore(stop_pid(worker_pid, "-KILL"))
      }
      coordinator_log.close()
      worker_log.close()
    }) catch { _ => () }
  }
  wait_for_tcp(driver_endpoint)

  println("[2/6] end-to-end latency and steady-state throughput")
  let latency = require_output(
    @shell.Cmd(
      performance,
      [
        "--endpoint", driver_endpoint,
        "--cluster", cluster,
        "--coordinator", "coordinator-0",
        "--job-config", submission,
        "--iterations", latency_iterations.to_string(),
        "--origin", "production-latency",
      ],
    ).output(timeout_ms=120000),
    "latency fixture",
  )
  let latency_p99 = metric(latency, "performance_input_p99_ms")
  if latency_p99 > maximum_input_p99_ms {
    fail("input p99 exceeded frozen limit: " + latency_p99.to_string())
  }
  let steady = require_output(
    @shell.Cmd(
      performance,
      [
        "--endpoint", driver_endpoint,
        "--cluster", cluster,
        "--coordinator", "coordinator-0",
        "--job-config", submission,
        "--duration-ms", steady_duration_ms.to_string(),
        "--batch-size", steady_batch_size.to_string(),
        "--paced-ms", steady_paced_ms.to_string(),
        "--origin", "production-steady",
      ],
    ).output(timeout_ms=120000),
    "steady fixture",
  )
  let steady_events = metric(steady, "performance_events")
  let steady_throughput = metric(steady, "performance_throughput_events_per_sec_x1000")
  if steady_events < minimum_steady_events || steady_throughput < minimum_throughput_x1000 {
    fail("steady-state target missed: events=" + steady_events.to_string() + " throughput_x1000=" + steady_throughput.to_string())
  }
  println("PASS: latency p99=" + latency_p99.to_string() + "ms")
  println("PASS: steady events=" + steady_events.to_string() + " throughput_x1000=" + steady_throughput.to_string())

  let drain = @shell.Cmd(
    driver,
    [
      "--endpoint", driver_endpoint,
      "--cluster", cluster,
      "--coordinator", "coordinator-0",
      "--job-config", submission,
      "--command", "drain",
    ],
  ).output(timeout_ms=30000)
  if drain.exit_code() != 0 {
    fail("performance cluster drain failed: " + drain.stdout())
  }
  wait_for_text(root + "/coordinator.log", "phase=Succeeded")
  let disk = @shell.Cmd("df", ["-B1", root]).output()
  write_evidence(
    root,
    evidence_header +
    "latency_result=\n" + latency +
    "steady_result=\n" + steady +
    "disk_after=\n" + disk.stdout() +
    "confirmed_data_loss=0\nreference_output_mismatches=0\n",
  )
  let coordinator_status = stop_pid(coordinator_pid, "-TERM")
  let worker_status = stop_pid(worker_pid, "-TERM")
  cluster_stopped = true
  println("PASS: graceful service drain coordinator_status=" + coordinator_status.to_string() + " worker_status=" + worker_status.to_string())

  println("[3/6] network unavailability fails closed")
  let unavailable_listener = @socket.TcpServer(@socket.Addr::parse("127.0.0.1:0"))
  let unavailable_endpoint = "127.0.0.1:" + unavailable_listener.addr.port().to_string()
  unavailable_listener.close()
  let unavailable = @shell.Cmd(
    driver,
    [
      "--endpoint", unavailable_endpoint,
      "--cluster", cluster,
      "--coordinator", "coordinator-0",
      "--job-config", submission,
      "--command", "status",
    ],
  ).output(timeout_ms=5000)
  if unavailable.exit_code() == 0 {
    fail("unreachable Driver endpoint was reported successful")
  }
  println("PASS: unavailable endpoint rejected with exit=" + unavailable.exit_code().to_string())

  println("[4/6] storage capacity refusal")
  let tiny_listener = @socket.TcpServer(@socket.Addr::parse("127.0.0.1:0"))
  let tiny_port = tiny_listener.addr.port()
  let tiny_driver_listener = @socket.TcpServer(@socket.Addr::parse("127.0.0.1:0"))
  let tiny_driver_port = tiny_driver_listener.addr.port()
  tiny_listener.close()
  tiny_driver_listener.close()
  let tiny_endpoint = "127.0.0.1:" + tiny_port.to_string()
  let tiny_driver_endpoint = "127.0.0.1:" + tiny_driver_port.to_string()
  let tiny_log = @process.redirect_to_file(root + "/tiny-budget.log")
  let tiny_pid = @process.spawn_orphan(
    coordinator,
    [
      "--cluster", "tiny-budget-cluster",
      "--coordinator", "coordinator-0",
      "--bind", tiny_endpoint,
      "--advertise", tiny_endpoint,
      "--driver-bind", tiny_driver_endpoint,
      "--driver-advertise", tiny_driver_endpoint,
      "--storage", root + "/tiny-budget",
      "--storage-budget-bytes", "4096",
      "--driver-event-limit", "8",
      "--workers", "worker-0@boot-0",
    ],
    stdout=tiny_log,
    stderr=tiny_log,
  )
  let mut tiny_done = false
  defer {
    @async.protect_from_cancel(() => {
      if !tiny_done {
        ignore(stop_pid(tiny_pid, "-KILL"))
      }
      tiny_log.close()
    }) catch { _ => () }
  }
  @async.sleep(1000)
  let tiny_submit = @shell.Cmd(
    performance,
    [
      "--endpoint", tiny_driver_endpoint,
      "--cluster", "tiny-budget-cluster",
      "--coordinator", "coordinator-0",
      "--job-config", submission,
      "--iterations", "64",
      "--origin", "tiny-budget",
    ],
  ).output(timeout_ms=5000)
  if tiny_submit.exit_code() == 0 {
    fail("tiny storage budget accepted writes beyond its durable capacity")
  }
  println("PASS: tiny storage budget failed closed exit=" + tiny_submit.exit_code().to_string())
  ignore(stop_pid(tiny_pid, "-KILL"))
  tiny_done = true

  println("[5/6] Kafka broker restart and offset recovery")
  @shell.Cmd("moon", ["run", "scripts/kafka_integration.mbtx", kafka]).run(timeout_ms=300000)
  println("PASS: Kafka failure and restart recovery")
  println("[6/6] evidence")
  println("PASS: production performance and fault acceptance; evidence=" + root + "/production-evidence.txt")
}
