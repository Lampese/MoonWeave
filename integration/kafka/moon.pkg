import {
  "moonweave/moonweave/runtime/api",
  "moonweave/moonweave/runtime/async" @runtime,
  "moonweave/moonweave/runtime/task",
  "moonweave/moonweave/operator/reachability",
  "moonweave/moonweave/causal",
  "daqing/moonkafka",
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/debug",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  link: { "native": { "cc-link-flags": "-lz" } },
)
